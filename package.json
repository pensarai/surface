{
  "name": "@pensar/surface",
  "version": "0.3.1",
  "description": "White-box endpoint discovery for source code repositories.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "surface": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pensarai/surface.git"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm run test:smoke",
    "check:dependency-pins": "node scripts/check-dependency-pins.mjs",
    "check:osv-gate": "node scripts/osv-gate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.11",
    "@types/js-yaml": "4.0.9",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "prettier": "3.8.1",
    "tsup": "8.5.1",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "nanoid": "3.3.18",
    "brace-expansion": "5.0.11",
    "picomatch": "4.0.7",
    "postcss": "8.5.18",
    "vite": "8.1.6"
  }
}
